# AI Provider Config
# Options: local, gemini, lmstudio, colab
LLM_PROVIDER=local

# Google Gemini (if using provider=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Local Model Path (if using provider=local and GGUF)
LOCAL_MODEL_PATH=models/your_model.gguf

# Remote / OpenAI Compatible (if using provider=lmstudio or colab)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=sk-no-key-needed
OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V3-0324
